{
	"name": "@redwind/ccusage",
	"version": "20.0.20",
	"description": "Personal ccusage build with model and workspace reports",
	"homepage": "https://github.com/RedwindA/ccusage#readme",
	"bugs": {
		"url": "https://github.com/RedwindA/ccusage/issues"
	},
	"license": "MIT",
	"author": "redwind",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RedwindA/ccusage.git",
		"directory": "apps/ccusage"
	},
	"bin": {
		"ccusage": "./src/cli.js"
	},
	"files": [
		"config-schema.json",
		"src/cli.js"
	],
	"type": "module",
	"publishConfig": {
