	},
	"scripts": {
		"build": "scripts/ensure-native-binary.nu && publint",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@types/node": "catalog:types"
	},
	"optionalDependencies": {
		"@redwind/ccusage-darwin-arm64": "workspace:*",
		"@redwind/ccusage-linux-x64": "workspace:*",
		"@redwind/ccusage-win32-x64": "workspace:*"
	}
